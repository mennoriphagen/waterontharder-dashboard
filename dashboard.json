function formatDate(dateString) {

  if (!dateString) return '-';

  const d = new Date(dateString);

  return d.toLocaleDateString(
    'nl-NL'
  );

}

const regeneraties =
  (historie.regenerations || [])
  .map(r => {

    return {

      datum:
        formatDate(r.date),

      liter:
        Number(
          r.liters_since_previous || 0
        ),

      dagen:
        Number(
          r.days_since_previous || 0
        )

    };

  });

const zoutvullingen =
  (historie.saltRefills || [])
  .map(z => {

    return {

      datum:
        formatDate(z.date),

      dagen: 0,

      regeneraties: 0,

      water:
        Number(
          z.meter_m3 || 0
        )

    };

  });

const dashboardData = {

  zoutniveau:
    Number(
      getVar('WO_ZoutNiveau')?.value || 0
    ),

  resterendKg:
    Number(
      getVar('WO_ResterendKg')?.value || 0
    ),

  waterSindsZoutvulling:
    Number(
      getVar('WO_WaterSindsZoutvulling')?.value || 0
    ),

  dagenSindsZoutvulling:
    Number(
      getVar('WO_DagenSindsZoutvulling')?.value || 0
    ),

  verwachteNavulling:
    getVar('WO_VerwachteNavulling')?.value || '-',

  laatsteRegeneratie:
    getVar('WO_LaatsteRegeneratieDatum')?.value || '-',

  capaciteitLiter:
    Number(
      getVar('WO_SindsRegeneratieLiter')?.value || 0
    ),

  capaciteitMax: 2300,

  regeneraties:

    regeneraties
      .sort(
        (a,b) =>
          b.datum.localeCompare(a.datum)
      ),

  zoutvullingen:

    zoutvullingen
      .sort(
        (a,b) =>
          b.datum.localeCompare(a.datum)
      ),

  laatsteUpdate:
    new Date()
      .toLocaleString('nl-NL')

};
